{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/archive/**",
              "components/core/**",
              "components/instrument/**",
              "components/navigation/**",
              "components/receiver/**",
              "components/schedule/**",
              "ui_kits/echo-mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|disabled|onChange|label|key|ref|className|style|children)$/]",
        "message": "<AlertSwitch> doesn't accept that prop. Declared props: on, disabled, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|theme|onThemeChange|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, theme, onThemeChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|note|onDismiss|children|height|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, title, note, onDismiss, children, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|full|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, full, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:coverage|permission|action|key|ref|className|style|children)$/]",
        "message": "<CoverageNote> doesn't accept that prop. Declared props: coverage, permission, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverageNote'] > JSXAttribute[name.name='permission'] > Literal[value!=/^(?:default|granted|denied|unsupported)$/]",
        "message": "<CoverageNote> permission must be one of 'default' | 'granted' | 'denied' | 'unsupported'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DetailHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:designator|name|tier|onBack|key|ref|className|style|children)$/]",
        "message": "<DetailHeader> doesn't accept that prop. Declared props: designator, name, tier, onBack."
      },
      {
        "selector": "JSXOpeningElement[name.name='DetailListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<DetailListItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='DetectorStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|periodSec|perMinute|expectedSec|consistency|key|ref|className|style|children)$/]",
        "message": "<DetectorStrip> doesn't accept that prop. Declared props: state, periodSec, perMinute, expectedSec, consistency."
      },
      {
        "selector": "JSXOpeningElement[name.name='DetectorStrip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|searching|detected|absent)$/]",
        "message": "<DetectorStrip> state must be one of 'idle' | 'searching' | 'detected' | 'absent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DirectoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:location|users|usersMax|snr|grid|selected|onAdopt|key|ref|className|style|children)$/]",
        "message": "<DirectoryRow> doesn't accept that prop. Declared props: location, users, usersMax, snr, grid, selected, onAdopt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Flag> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|dim|danger|ok)$/]",
        "message": "<Flag> tone must be one of 'accent' | 'dim' | 'danger' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GapNoticeLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|url|description|key|ref|className|style|children)$/]",
        "message": "<GapNoticeLink> doesn't accept that prop. Declared props: label, url, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='LivePulse'] > JSXAttribute > JSXIdentifier[name!=/^(?:periodSec|size|color|title|key|ref|className|style|children)$/]",
        "message": "<LivePulse> doesn't accept that prop. Declared props: periodSec, size, color, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:khz|mode|timeOfDay|lastConfirmed|sourceUrl|disputed|key|ref|className|style|children)$/]",
        "message": "<ProvenanceRow> doesn't accept that prop. Declared props: khz, mode, timeOfDay, lastConfirmed, sourceUrl, disputed."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceRow'] > JSXAttribute[name.name='timeOfDay'] > Literal[value!=/^(?:day|night)$/]",
        "message": "<ProvenanceRow> timeOfDay must be one of 'day' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReceiverRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|meta|live|periodSec|flag|onOpen|key|ref|className|style|children)$/]",
        "message": "<ReceiverRow> doesn't accept that prop. Declared props: label, value, meta, live, periodSec, flag, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:designator|name|utc|local|countdown|khz|note|urgent|alertOn|alertDisabled|onToggleAlert|key|ref|className|style|children)$/]",
        "message": "<ScheduleRow> doesn't accept that prop. Declared props: designator, name, utc, local, countdown, khz, note, urgent, alertOn, alertDisabled, onToggleAlert."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='StationRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:designator|name|operator|tier|periodSec|disputed|onOpen|key|ref|className|style|children)$/]",
        "message": "<StationRow> doesn't accept that prop. Declared props: designator, name, operator, tier, periodSec, disputed, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='StationRow'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:live|scheduled|historical)$/]",
        "message": "<StationRow> tier must be one of 'live' | 'scheduled' | 'historical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|tone|action|key|ref|className|style|children)$/]",
        "message": "<StatusLine> doesn't accept that prop. Declared props: message, tone, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|live|danger|ok)$/]",
        "message": "<StatusLine> tone must be one of 'neutral' | 'live' | 'danger' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|tabs|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: value, onChange, tabs."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:live|schedule|archive)$/]",
        "message": "<TabBar> value must be one of 'live' | 'schedule' | 'archive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ThemePicker> doesn't accept that prop. Declared props: value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<TierHeader> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:running|connecting|onConnect|onStop|onSynthetic|showSynthetic|key|ref|className|style|children)$/]",
        "message": "<TransportBar> doesn't accept that prop. Declared props: running, connecting, onConnect, onStop, onSynthetic, showSynthetic."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaterfallPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|mock|frozen|periodSec|key|ref|className|style|children)$/]",
        "message": "<WaterfallPanel> doesn't accept that prop. Declared props: rows, mock, frozen, periodSec."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaterfallPanel'] > JSXAttribute[name.name='mock'] > Literal[value!=/^(?:detected|noise|blank)$/]",
        "message": "<WaterfallPanel> mock must be one of 'detected' | 'noise' | 'blank'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
