{
  "name": "project-echo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shortwave channel-marker monitor and numbers-station archive",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node server/index.mjs",
    "start": "npm run build && npm run server",
    "diagnostic-wav": "node scripts/make-diagnostic-wav.mjs",
    "import-priyom": "node scripts/import-priyom.mjs",
    "import-lore": "node scripts/import-lore.mjs",
    "make-world-path": "node scripts/make-world-path.mjs",
    "relay": "node scripts/relay.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "hls.js": "^1.7.2",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
